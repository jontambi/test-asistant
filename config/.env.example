# ============================================
# KIDS GROWING CLINIC - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ============================================
# ANTHROPIC (CLAUDE AI)
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# GOOGLE SERVICES
# ============================================
# Google Calendar API
# Setup: https://console.cloud.google.com/
GOOGLE_CALENDAR_ID=your_primary_calendar_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Google Sheets API
# Sheet ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_PRICING_ID=your_google_sheet_id_here

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=kids_growing_clinic
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_SSL=false

# Full connection string (alternative to individual params)
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# REDIS (Session/Memory Storage)
# ============================================
# Redis for conversation memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Alternative: Redis connection URL
# REDIS_URL=redis://:password@host:port/db

# ============================================
# TELEGRAM BOT API
# ============================================
# Telegram Bot API credentials
# Get your bot token from @BotFather on Telegram
# Setup: https://core.telegram.org/bots#creating-a-new-bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_default_chat_id

# ============================================
# EMAIL (SMTP)
# ============================================
# SMTP server for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Clinic email (shown to users)
CLINIC_EMAIL=contacto@kidsgrowing.com
CLINIC_SUPPORT_EMAIL=soporte@kidsgrowing.com

# ============================================
# CLINIC INFORMATION
# ============================================
CLINIC_NAME=Kids Growing - Clínica Pediátrica
CLINIC_PHONE=+1 (555) 123-4567
CLINIC_ADDRESS=Av. Principal #123, Ciudad
CLINIC_WEBSITE=https://www.kidsgrowing.com

# Working hours (JSON format)
CLINIC_HOURS_WEEKDAY=08:00-18:00
CLINIC_HOURS_SATURDAY=09:00-14:00
CLINIC_TIMEZONE=America/Mexico_City

# ============================================
# N8N CONFIGURATION
# ============================================
# N8N webhook base URL
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook

# N8N webhook paths (auto-generated, but you can customize)
N8N_WEBHOOK_CHAT=/lucia-chat
N8N_WEBHOOK_APPOINTMENTS=/lucia-appointments
N8N_WEBHOOK_PRICING=/lucia-pricing
N8N_WEBHOOK_PATIENT_DATA=/lucia-patient-data

# N8N security
N8N_WEBHOOK_AUTH_ENABLED=true
N8N_WEBHOOK_AUTH_TOKEN=your_secure_webhook_token

# ============================================
# SECURITY & COMPLIANCE
# ============================================
# Encryption key for sensitive data (generate a strong random key)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Session settings
SESSION_TIMEOUT_MINUTES=60
SESSION_SECRET=your_session_secret_key

# CORS settings (for web widget)
ALLOWED_ORIGINS=https://www.kidsgrowing.com,https://app.kidsgrowing.com

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features
ENABLE_VOICE_CALLS=true
ENABLE_TELEGRAM=true
ENABLE_EMAIL_REMINDERS=true
ENABLE_24H_REMINDER=true
ENABLE_1H_REMINDER=true

# ============================================
# LOGGING & MONITORING
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# ============================================
# DEVELOPMENT/TESTING
# ============================================
# Set to 'development' or 'production'
NODE_ENV=production

# Test mode (disables actual SMS/email sending)
TEST_MODE=false
TEST_PHONE_NUMBER=+1234567890
TEST_EMAIL=test@example.com
