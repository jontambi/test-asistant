    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM patients \nWHERE \n  LOWER(patient_name) LIKE LOWER('%{{$json.patientName}}%') \n  OR LOWER(parent_name) LIKE LOWER('%{{$json.parentName}}%')\n  OR parent_email = '{{$json.parentEmail}}'\n  OR parent_phone = '{{$json.parentPhone}}'\nLIMIT 20",
        "options": {}
      },
      "id": "search-patient-records",
      "name": "Database - Search Patients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [850, 500],
      "credentials": {
        "postgres": {
          "id": "postgres-credentials",
          "name": "PostgreSQL Account"
        }
      }
