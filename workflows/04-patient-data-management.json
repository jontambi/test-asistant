    {
      "parameters": {
        "functionCode": "// Parse patient data request\nconst action = $json.body.action; // 'create', 'update', 'get', 'search'\nconst patientData = $json.body.patientData || {};\n\nreturn {\n  json: {\n    action: action,\n    patientId: patientData.patientId,\n    patientName: patientData.patientName,\n    patientAge: patientData.patientAge,\n    dateOfBirth: patientData.dateOfBirth,\n    gender: patientData.gender,\n    parentName: patientData.parentName,\n    parentEmail: patientData.parentEmail,\n    parentPhone: patientData.parentPhone,\n    address: patientData.address,\n    insuranceProvider: patientData.insuranceProvider,\n    insurancePolicyNumber: patientData.insurancePolicyNumber,\n    allergies: patientData.allergies || [],\n    medicalConditions: patientData.medicalConditions || [],\n    medications: patientData.medications || [],\n    emergencyContactName: patientData.emergencyContactName,\n    emergencyContactPhone: patientData.emergencyContactPhone,\n    sessionId: $json.body.sessionId,\n    userId: $json.body.userId\n  }\n};"
      },
