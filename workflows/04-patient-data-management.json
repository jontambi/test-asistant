    {
      "parameters": {
        "functionCode": "// Format patient data for response (removing sensitive info if needed)\nconst patientData = $json;\n\n// Check if this is a GDPR/privacy compliant request\n// For chat interface, limit what info is shared\n\nconst safeData = {\n  patientId: patientData.patient_id,\n  patientName: patientData.patient_name,\n  age: patientData.age,\n  parentName: patientData.parent_name,\n  // Mask sensitive data\n  parentEmail: patientData.parent_email ? patientData.parent_email.replace(/(.{3}).*(@.*)/, '$1***$2') : '',\n  parentPhone: patientData.parent_phone ? patientData.parent_phone.replace(/(\\d{3})\\d{4}(\\d{3})/, '$1****$2') : '',\n  hasInsurance: !!patientData.insurance_provider,\n  registeredDate: patientData.created_at\n};\n\nreturn {\n  json: {\n    success: true,\n    action: 'patient_retrieved',\n    patient: safeData,\n    fullData: patientData // Only use in secure contexts\n  }\n};"
      },
      "id": "format-patient-response",
      "name": "Format Patient Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "functionCode": "// Log patient data activity for compliance (GDPR, HIPAA)\nconst action = $input.first().json.action;\nconst patientId = $json.patient_id || $input.first().json.patientId;\nconst userId = $input.first().json.userId;\n\nreturn {\n  json: {\n    activity_type: action,\n    patient_id: patientId,\n    user_id: userId,\n    timestamp: new Date().toISOString(),\n    ip_address: $input.first().json.body?.headers?.['x-forwarded-for'] || 'unknown',\n    user_agent: $input.first().json.body?.headers?.['user-agent'] || 'unknown'\n  }\n};"
      },
