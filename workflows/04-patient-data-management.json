    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE patients SET \n  patient_name = '{{$json.patientName}}',\n  age = {{$json.patientAge}},\n  parent_name = '{{$json.parentName}}',\n  parent_email = '{{$json.parentEmail}}',\n  parent_phone = '{{$json.parentPhone}}',\n  address = '{{$json.address}}',\n  insurance_provider = '{{$json.insuranceProvider}}',\n  insurance_policy_number = '{{$json.insurancePolicyNumber}}',\n  allergies = '{{JSON.stringify($json.allergies)}}',\n  medical_conditions = '{{JSON.stringify($json.medicalConditions)}}',\n  medications = '{{JSON.stringify($json.medications)}}',\n  emergency_contact_name = '{{$json.emergencyContactName}}',\n  emergency_contact_phone = '{{$json.emergencyContactPhone}}',\n  updated_at = NOW()\nWHERE patient_id = {{$json.patientId}}",
        "options": {}
      },
