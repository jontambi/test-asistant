{
  "name": "Lucía - Appointment Management",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lucia-appointments",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-appointment-request",
      "name": "Webhook - Appointment Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "lucia-appointments-webhook"
    },
    {
      "parameters": {
        "functionCode": "// Parse appointment request\nconst action = $json.body.action; // 'check_availability', 'create', 'update', 'cancel'\nconst appointmentData = $json.body.appointmentData || {};\n\nreturn {\n  json: {\n    action: action,\n    patientName: appointmentData.patientName,\n    patientAge: appointmentData.patientAge,\n    parentName: appointmentData.parentName,\n    parentEmail: appointmentData.parentEmail,\n    parentPhone: appointmentData.parentPhone,\n    reasonForVisit: appointmentData.reasonForVisit,\n    preferredDate: appointmentData.preferredDate,\n    preferredTime: appointmentData.preferredTime,\n    appointmentId: appointmentData.appointmentId, // For update/cancel\n    sessionId: $json.body.sessionId,\n    userId: $json.body.userId\n  }\n};"
      },
      "id": "parse-appointment-request",
      "name": "Parse Appointment Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "operation": "equals",
              "value2": "check_availability"
            }
          ]
        }
      },
      "id": "route-action",
      "name": "Route Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [650, 300],
      "parameters": {
        "rules": {
          "rules": [
            {
              "operation": "equals",
              "value1": "={{$json.action}}",
              "value2": "check_availability"
            },
            {
              "operation": "equals",
              "value1": "={{$json.action}}",
              "value2": "create"
            },
            {
              "operation": "equals",
              "value1": "={{$json.action}}",
              "value2": "update"
            },
            {
              "operation": "equals",
              "value1": "={{$json.action}}",
              "value2": "cancel"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "resource": "calendar",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "options": {
          "timeMax": "={{$json.preferredDate}}T23:59:59Z",
          "timeMin": "={{$json.preferredDate}}T08:00:00Z"
        }
      },
      "id": "check-calendar-availability",
      "name": "Google Calendar - Check Availability",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [850, 200],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "google-calendar-credentials",
          "name": "Google Calendar Account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Calculate available time slots\nconst preferredDate = $input.first().json.preferredDate;\nconst existingEvents = $json || [];\n\n// Clinic hours: 8:00 AM - 6:00 PM (Mon-Fri), 9:00 AM - 2:00 PM (Sat)\nconst date = new Date(preferredDate);\nconst dayOfWeek = date.getDay(); // 0 = Sunday, 6 = Saturday\n\n// Check if clinic is closed (Sunday)\nif (dayOfWeek === 0) {\n  return {\n    json: {\n      available: false,\n      reason: 'La clínica está cerrada los domingos',\n      availableSlots: [],\n      nextAvailableDate: null\n    }\n  };\n}\n\n// Define working hours based on day\nlet startHour = 8;\nlet endHour = 18;\nif (dayOfWeek === 6) { // Saturday\n  startHour = 9;\n  endHour = 14;\n}\n\n// Generate 30-minute time slots\nconst allSlots = [];\nfor (let hour = startHour; hour < endHour; hour++) {\n  for (let minute of [0, 30]) {\n    const timeSlot = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;\n    allSlots.push(timeSlot);\n  }\n}\n\n// Filter out occupied slots (simplified - checking event overlaps)\nconst occupiedSlots = [];\nif (Array.isArray(existingEvents)) {\n  existingEvents.forEach(event => {\n    if (event.start && event.start.dateTime) {\n      const eventStart = new Date(event.start.dateTime);\n      const timeSlot = `${String(eventStart.getHours()).padStart(2, '0')}:${String(eventStart.getMinutes()).padStart(2, '0')}`;\n      occupiedSlots.push(timeSlot);\n    }\n  });\n}\n\nconst availableSlots = allSlots.filter(slot => !occupiedSlots.includes(slot));\n\nreturn {\n  json: {\n    available: availableSlots.length > 0,\n    availableSlots: availableSlots.slice(0, 10), // Return first 10 available slots\n    requestedDate: preferredDate,\n    totalSlotsAvailable: availableSlots.length\n  }\n};"
      },
      "id": "calculate-available-slots",
      "name": "Calculate Available Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "calendar": "primary",
        "start": "={{$json.preferredDate}}T{{$json.preferredTime}}:00",
        "end": "={{new Date(new Date($json.preferredDate + 'T' + $json.preferredTime).getTime() + 30*60000).toISOString()}}",
        "summary": "Consulta Pediátrica - {{$json.patientName}}",
        "description": "**Paciente:** {{$json.patientName}} ({{$json.patientAge}} años)\\n**Padre/Madre:** {{$json.parentName}}\\n**Teléfono:** {{$json.parentPhone}}\\n**Email:** {{$json.parentEmail}}\\n**Motivo:** {{$json.reasonForVisit}}",
        "options": {
          "sendUpdates": "all"
        },
        "attendees": "={{$json.parentEmail}}"
      },
